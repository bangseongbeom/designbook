{
  "name": "@designbook/monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build-designbook": "turbo run build-designbook",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
